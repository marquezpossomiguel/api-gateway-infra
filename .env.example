# Hostname público del gateway
GATEWAY_SERVER_NAME=api.example.com

# Puertos expuestos por el gateway
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443

# CORS
CORS_ALLOW_ORIGIN=https://app.example.com
CORS_ALLOW_CREDENTIALS=true

# Paths dentro del contenedor Nginx
TLS_CERT_PATH=/etc/nginx/certs/fullchain.pem
TLS_KEY_PATH=/etc/nginx/certs/privkey.pem

# Paths en host (docker-compose bind mounts)
TLS_CERT_HOST_PATH=./certs/fullchain.pem
TLS_KEY_HOST_PATH=./certs/privkey.pem

# Seguridad / límites
CLIENT_MAX_BODY_SIZE=50m

# Auth service (interno)
AUTH_SERVICE_HOST=auth-service
AUTH_SERVICE_PORT=8001
AUTH_SERVICE_IMAGE=ghcr.io/example/auth-service:latest
AUTH_VALIDATE_PATH=/internal/jwt/validate

# Medical Imaging service (interno)
MEDICAL_IMAGING_SERVICE_HOST=medical-imaging-service
MEDICAL_IMAGING_SERVICE_PORT=8002
MEDICAL_IMAGING_SERVICE_IMAGE=ghcr.io/example/medical-imaging-service:latest
