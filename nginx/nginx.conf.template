worker_processes auto;

error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;

  log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                  '$status $body_bytes_sent "$http_referer" '
                  '"$http_user_agent" "$http_x_forwarded_for" '
                  'request_time=$request_time upstream_time=$upstream_response_time';

  access_log /var/log/nginx/access.log main;

  sendfile on;
  tcp_nopush on;
  tcp_nodelay on;
  keepalive_timeout 65;
  types_hash_max_size 4096;
  server_tokens off;
  client_max_body_size ${CLIENT_MAX_BODY_SIZE};

  map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
  }

  map $http_origin $cors_allow_origin {
    default "";
    "${CORS_ALLOW_ORIGIN}" $http_origin;
  }

  upstream auth_service {
    server ${AUTH_SERVICE_HOST}:${AUTH_SERVICE_PORT};
    keepalive 16;
  }

  upstream medical_imaging_service {
    server ${MEDICAL_IMAGING_SERVICE_HOST}:${MEDICAL_IMAGING_SERVICE_PORT};
    keepalive 16;
  }

  server {
    listen ${GATEWAY_HTTP_PORT};
    server_name ${GATEWAY_SERVER_NAME};
    return 301 https://$host$request_uri;
  }

  server {
    listen ${GATEWAY_HTTPS_PORT} ssl http2;
    server_name ${GATEWAY_SERVER_NAME};

    ssl_certificate ${TLS_CERT_PATH};
    ssl_certificate_key ${TLS_KEY_PATH};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers on;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;

    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; frame-ancestors 'none'" always;
    add_header Access-Control-Allow-Origin "$cors_allow_origin" always;
    add_header Access-Control-Allow-Credentials "${CORS_ALLOW_CREDENTIALS}" always;
    add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Authorization, Content-Type, X-Requested-With" always;
    add_header Access-Control-Max-Age 86400 always;
    add_header Access-Control-Expose-Headers "Content-Length, Content-Type" always;

    location = /health {
      default_type text/plain;
      return 200 'ok';
    }

    location / {
      return 404;
    }

    location /auth/ {
      proxy_http_version 1.1;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Host $host;
      proxy_set_header X-Request-Id $request_id;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_pass http://auth_service;
    }

    location /dicom/ {
      limit_except OPTIONS {
        auth_request /_internal/jwt/validate;
      }

      proxy_http_version 1.1;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Host $host;
      proxy_set_header X-Request-Id $request_id;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header Authorization $http_authorization;
      proxy_pass http://medical_imaging_service;
    }

    location = /_internal/jwt/validate {
      internal;
      proxy_pass http://auth_service${AUTH_VALIDATE_PATH};
      proxy_set_header Authorization $http_authorization;
      proxy_set_header X-Original-URI $request_uri;
      proxy_pass_request_body off;
      proxy_set_header Content-Length "";
    }
  }
}
